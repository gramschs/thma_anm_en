                         0.022, 0.020, 0.019, 0.018, 0.028, 0.030])\n\ni_best = np.argmax(efficiency)\n\nfig, ax = plt.subplots(figsize=(7, 4))\n\nax.errorbar(rpm, efficiency, yerr=efficiency_std,\n            fmt='o', capsize=4, label='Measurement')\nax.scatter(rpm[i_best], efficiency[i_best],\n           marker='*', s=200, color='red', zorder=5, label='Best operating point')\n\nax.set_xlabel('Rotational speed in 1/min')\nax.set_ylabel('Efficiency')\nax.set_title('Efficiency with measurement uncertainty')\nax.legend()\nax.grid(True)\n\nplt.show()","position":{"start":{"line":179,"column":1},"end":{"line":199,"column":1}},"key":"KUma3PTVFB"},{"type":"paragraph","position":{"start":{"line":200,"column":1},"end":{"line":203,"column":1}},"children":[{"type":"text","value":"The error bars are largest relative to the measured value at low rotational\nspeed, because the efficiency itself is small there. The best operating point\nat 2000 1/min, on the other hand, is determined very precisely. The\n","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"YWadikAuLR"},{"type":"inlineCode","value":"zorder=5","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"E5ASI9wVke"},{"type":"text","value":" ensures that the star lies above the error bars.","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"vzJSDrWUUm"}],"key":"gEqvRj6fQD"}],"class":"tip dropdown","key":"t6JqVvSVcD"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Closing question","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"sOh1qC1LMV"}],"key":"QsF7s9jUZv"},{"type":"paragraph","position":{"start":{"line":208,"column":1},"end":{"line":208,"column":1}},"children":[{"type":"text","value":"Answer in your own words, without further code:","position":{"start":{"line":208,"column":1},"end":{"line":208,"column":1}},"key":"jE1LWknR9n"}],"key":"ABdbfLC4rT"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":210,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":210,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The motor delivers its largest mechanical power at 1500 1/min, but works\nmost efficiently at 2000 1/min. For which rotational speed would you design\nthe motor for continuous operation? Justify.","position":{"start":{"line":210,"column":1},"end":{"line":210,"column":1}},"key":"CKUS4v8tNS"}],"key":"Y6a6571Srl"}],"key":"dOOuLKlBmW"},{"type":"listItem","spread":true,"position":{"start":{"line":213,"column":1},"end":{"line":215,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At which measured points is the relative measurement uncertainty of the\nefficiency largest? What follows from this for planning further\nmeasurements?","position":{"start":{"line":213,"column":1},"end":{"line":213,"column":1}},"key":"mBAKsEeUe1"}],"key":"ELmcvlz10D"}],"key":"UBU9eI47bg"}],"key":"rCTWOYSnt4"}],"class":"tip","key":"vNhinTAQkt"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution closing question","position":{"start":{"line":218,"column":1},"end":{"line":218,"column":1}},"key":"iriJK99Y8Q"}],"key":"iDZEtdntyW"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":221,"column":1},"end":{"line":233,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":221,"column":1},"end":{"line":226,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For continuous operation, one usually chooses a rotational speed close to\nthe best efficiency, that is, about 2000 1/min. There, the least energy is\nlost as heat, the motor runs cooler and the operating costs are lower. The\nmaximum power at 1500 1/min is more of interest for short-term load peaks.\nIf the application permanently needs the highest power, the lower\nefficiency must be deliberately accepted.","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"UxsPQN1eGj"}],"key":"FDi10drs97"}],"key":"NNcp23tNHA"},{"type":"listItem","spread":true,"position":{"start":{"line":227,"column":1},"end":{"line":233,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The relative uncertainty is the quotient of ","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"q2FQYwOUVG"},{"type":"inlineCode","value":"efficiency_std","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"ilmniyErt4"},{"type":"text","value":" and\n","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"k7F5ggS7Yv"},{"type":"inlineCode","value":"efficiency","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"vzWUHeJmhk"},{"type":"text","value":". It is largest at the low rotational speeds, because the\nefficiency itself is small there, while the absolute scatter stays\nsimilar. At 250 1/min it is over ten percent. For further measurements it\nis worth taking more repeats in the lower rotational-speed range or using\na more accurate measurement method. The well-measured range around\n2000 1/min, on the other hand, needs less effort.","position":{"start":{"line":227,"column":1},"end":{"line":227,"column":1}},"key":"ItHYAb6LEp"}],"key":"aimS88wy0B"}],"key":"eZMKJLDxT4"}],"key":"xx3dVt1PDc"}],"class":"tip dropdown","key":"vfZdDSSXHD"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Bonus exercise: Second test-rig run with a warm motor (✩✩✩)","position":{"start":{"line":236,"column":1},"end":{"line":236,"column":1}},"key":"i9JMFAOb5A"}],"key":"wWzc06yLRC"},{"type":"paragraph","position":{"start":{"line":238,"column":1},"end":{"line":240,"column":1}},"children":[{"type":"text","value":"After an hour of continuous running, the motor is warm. A second test-rig run\nat the same rotational speeds and the same torque delivers a higher power\ninput, because the winding resistances rise with temperature:","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"bw1jC6NT5V"}],"key":"qscplhWEvB"},{"type":"code","lang":"python","value":"power_input_warm = np.array([1420, 1780, 1880, 1680, 1370, 1100,\n                             910, 830, 770, 710, 660, 560])   # W","position":{"start":{"line":242,"column":1},"end":{"line":245,"column":1}},"key":"L7PhS09zF3"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":247,"column":1},"end":{"line":252,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":247,"column":1},"end":{"line":248,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compute the efficiency ","position":{"start":{"line":247,"column":1},"end":{"line":247,"column":1}},"key":"xspFOgHQ21"},{"type":"inlineCode","value":"efficiency_warm","position":{"start":{"line":247,"column":1},"end":{"line":247,"column":1}},"key":"TIssb7pPjU"},{"type":"text","value":" for the warm run. The torque, and\nthus ","position":{"start":{"line":247,"column":1},"end":{"line":247,"column":1}},"key":"nHr3Cfl9dI"},{"type":"inlineCode","value":"p_mech","position":{"start":{"line":247,"column":1},"end":{"line":247,"column":1}},"key":"ZTLI01kI8c"},{"type":"text","value":", stay unchanged.","position":{"start":{"line":247,"column":1},"end":{"line":247,"column":1}},"key":"SlSv2NPuRx"}],"key":"z49s2FTqbq"}],"key":"JKph5fE6wt"},{"type":"listItem","spread":true,"position":{"start":{"line":249,"column":1},"end":{"line":250,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plot both efficiency curves, cold and warm, in a common diagram, with a\nlegend.","position":{"start":{"line":249,"column":1},"end":{"line":249,"column":1}},"key":"rGcJN74kYt"}],"key":"pJ3ebx1tST"}],"key":"ocXpSFXRrb"},{"type":"listItem","spread":true,"position":{"start":{"line":251,"column":1},"end":{"line":252,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compare: how much does the peak efficiency drop? Does the rotational speed\nof the best operating point shift?","position":{"start":{"line":251,"column":1},"end":{"line":251,"column":1}},"key":"Kfmqg82h0m"}],"key":"rYZYnEo2Ic"}],"key":"Undf8E92S5"}],"key":"BwST2EBVSA"}],"class":"tip","key":"PuoIste275"}],"key":"Q1ZCVrN1OH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# code cell","key":"q8s5c3hmvf"},{"type":"outputs","id":"lHIhdAf0rK2b-fPEBpin0","children":[],"key":"AJMrfvMVdW"}],"key":"LYb2eLRSHY"},{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution bonus exercise","position":{"start":{"line":259,"column":1},"end":{"line":259,"column":1}},"key":"VTX4cLPJUs"}],"key":"W1739nq4Vu"},{"type":"code","lang":"python","value":"power_input_warm = np.array([1420, 1780, 1880, 1680, 1370, 1100,\n                             910, 830, 770, 710, 660, 560])\n\nefficiency_warm = p_mech / power_input_warm\n\nfig, ax = plt.subplots(figsize=(7, 4))\nax.plot(rpm, efficiency,      marker='o', label='Cold motor')\nax.plot(rpm, efficiency_warm, marker='o', label='Warm motor')\nax.set_xlabel('Rotational speed in 1/min')\nax.set_ylabel('Efficiency')\nax.set_title('Efficiency with a cold and a warm motor')\nax.set_ylim(0, 1)\nax.legend()\nax.grid(True)\nplt.show()\n\nprint(f\"Peak efficiency cold: {np.max(efficiency):.2f} \"\n      f\"at {rpm[np.argmax(efficiency)]} 1/min\")\nprint(f\"Peak efficiency warm: {np.max(efficiency_warm):.2f} \"\n      f\"at {rpm[np.argmax(efficiency_warm)]} 1/min\")","position":{"start":{"line":262,"column":1},"end":{"line":283,"column":1}},"key":"QeXq7LxHZv"},{"type":"paragraph","position":{"start":{"line":284,"column":1},"end":{"line":289,"column":1}},"children":[{"type":"text","value":"The peak efficiency drops from about 0.84 to about 0.73, that is, by more than\nten percentage points. The rotational speed of the best operating point\nstays at 2000 1/min. The motor temperature therefore noticeably worsens the\nefficiency without shifting the location of the optimum. For a reliable\nreport, the operating temperature at which the measurement was taken should\nalways be stated.","position":{"start":{"line":284,"column":1},"end":{"line":284,"column":1}},"key":"XgrJp7XK8b"}],"key":"n9JLAWJIfz"}],"class":"tip dropdown","key":"bn6tdKS4S8"}],"key":"sXhN7sGZrz"}],"key":"x6ZbRY5F1Y"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2.3 Diagrams with Matplotlib","url":"/chapter02-sec03","group":"2. NumPy & Matplotlib"},"next":{"title":"2.5 Exercises","url":"/chapter02-sec05","group":"2. NumPy & Matplotlib"}}},"domain":"http://localhost:3000"}