}},"key":"BSWSESKHUF"},{"type":"inlineCode","value":"efficiency","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"Vk3Y8xdOM6"},{"type":"text","value":".","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"JDgW7en2fr"}],"key":"NVSRbF3C73"}],"class":"tip","key":"HsYdvuN8ll"}],"key":"rafhAfkbVJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# code cell","key":"SepZ1nqvTu"},{"type":"outputs","id":"KzZ3kAG5KXhcR6IUw6fxs","children":[],"key":"hwWF6C3UXA"}],"key":"b7QTZwRPt8"},{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution Part 4","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"tIhYRmniHk"}],"key":"QuD6CKWBV5"},{"type":"code","lang":"python","value":"electrical_power = rotor_power * efficiency\nprint(electrical_power)","position":{"start":{"line":125,"column":1},"end":{"line":128,"column":1}},"key":"BNVFOKlspq"},{"type":"paragraph","position":{"start":{"line":129,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"text","value":"Both arrays have eight elements, so NumPy multiplies them pairwise: at each\npoint in time the rotor power is weighted by the corresponding efficiency. At\nthe first point in time the result is 0 W, because the generator has not yet\nstarted up.","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"s6bCRp0fun"}],"key":"gvhUaVJpjq"}],"class":"tip dropdown","key":"UYt4NqLfCS"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Part 5: Characterize the test run","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"uY17feVh8N"}],"key":"ww7yOEYlTW"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"Determine the mean, minimum and maximum delivered power, as well as the\nscatter of the power around the mean.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"lo4w6ccQeT"}],"key":"F4NRkolqj7"}],"class":"tip","key":"meopJ8s5I4"}],"key":"EwqJCuHUlQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# code cell","key":"a2jnCIkAmp"},{"type":"outputs","id":"mMu1WT96dD23knErweL5M","children":[],"key":"YWS7rNadv8"}],"key":"tYJHdM26qg"},{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution Part 5","position":{"start":{"line":145,"column":1},"end":{"line":145,"column":1}},"key":"Yigv3hKge9"}],"key":"RjOTg9YcEj"},{"type":"code","lang":"python","value":"mean_power = np.mean(electrical_power)\nmin_power = np.min(electrical_power)\nmax_power = np.max(electrical_power)\nspread = np.std(electrical_power)\n\nprint(f\"Mean:    {mean_power:.1f} W\")\nprint(f\"Minimum: {min_power:.1f} W\")\nprint(f\"Maximum: {max_power:.1f} W\")\nprint(f\"Spread:  {spread:.1f} W\")","position":{"start":{"line":148,"column":1},"end":{"line":158,"column":1}},"key":"qLuggpQxnx"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"The minimum of 0 W comes from the first point in time, at which the generator\nis still at rest. The scatter is of the same order of magnitude as the mean,\nso the test run delivers a very uneven power. This is due both to the\nstart-up phase of the generator and to the fluctuating wind speed.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"fSg52nA4ZF"}],"key":"G06EUOnqHr"}],"class":"tip dropdown","key":"wYFEHJZ1go"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Closing question","position":{"start":{"line":165,"column":1},"end":{"line":165,"column":1}},"key":"aHK00gFlK