"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"u1KA1Ks8UJ"},{"type":"text","value":" (hint: start with ","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"UYDYnAvhnY"},{"type":"inlineCode","value":"max_energy = 0","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"msjawfLEss"},{"type":"text","value":" before the loop\nand compare in each pass with an ","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"bAiUsnXUfv"},{"type":"inlineCode","value":"if","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"zI5sH3nhbM"},{"type":"text","value":" check).","position":{"start":{"line":204,"column":1},"end":{"line":204,"column":1}},"key":"pmDAaUSrpF"}],"key":"yoqfzv9Wzi"},{"type":"paragraph","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"strong","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"children":[{"type":"text","value":"Part 3:","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"EQAtlo3kYA"}],"key":"ZqP0XrRDRi"},{"type":"text","value":" Print the largest energy value found after the loop.","position":{"start":{"line":209,"column":1},"end":{"line":209,"column":1}},"key":"yu9oUMbqNq"}],"key":"QXGnZoZ1Jd"},{"type":"paragraph","position":{"start":{"line":211,"column":1},"end":{"line":212,"column":1}},"children":[{"type":"strong","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"Closing question:","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"xGtYnN3vRO"}],"key":"Xkk7Vvr6pJ"},{"type":"text","value":" At which speed from the measurement series does this\nmaximum value occur, and why can we guess this even without running the code?","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"avwvaAYAgm"}],"key":"lajjzJJzSM"}],"class":"tip","key":"XWWWnskW2Y"}],"key":"yrWZmvZfZO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# code cell","key":"t8akWkcxcW"},{"type":"outputs","id":"oEVQt04-5gfFxH9KTvci6","children":[],"key":"mP3mZQjBZ3"}],"key":"pdFYF8cisW"},{"type":"block","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Solution","position":{"start":{"line":219,"column":1},"end":{"line":219,"column":1}},"key":"R9hmpVN6Df"}],"key":"tnOWjujIWP"},{"type":"code","lang":"python","value":"def kinetic_energy(speed_kmh, mass=1200):\n    speed_ms = speed_kmh / 3.6\n    return 0.5 * mass * speed_ms**2\n\nspeeds_kmh = [72, 88, 95, 60, 110, 130]\n\nmax_energy = 0\nfor speed_kmh in speeds_kmh:\n    energy = kinetic_energy(speed_kmh)\n    if energy > max_energy:\n        max_energy = energy\n\nprint(f'Maximum kinetic energy: {max_energy:.1f} joules')","position":{"start":{"line":222,"column":1},"end":{"line":236,"column":1}},"key":"vKKvduF2jb"},{"type":"paragraph","position":{"start":{"line":237,"column":1},"end":{"line":241,"column":1}},"children":[{"type":"text","value":"The maximum value occurs at 130 km/h, the largest value in the measurement\nseries. Since the kinetic energy grows with the square of the speed and the\nmass stays constant over the entire measurement series, the maximum of the\nenergy is always at the highest measured speed. We can therefore derive this\nfrom the formula alone, without running the code.","position":{"start":{"line":237,"column":1},"end":{"line":237,"column":1}},"key":"uNxSU4vqVU"}],"key":"O3MnYqgELd"}],"class":"tip dropdown","key":"twpwdEArRC"}],"key":"MgEQGBd8es"}],"key":"rtmSTdJa3m"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"1.3 Lists, Dictionaries and Functions","url":"/chapter01-sec03","group":"1. Crashkurs Python"},"next":{"title":"1.5 Exercises","url":"/chapter01-sec05","group":"1.